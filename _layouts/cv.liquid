---
layout: default
---
{% assign resume = site.data.resume %}
<div class="post cv-page">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    <div class="cv-contact">
      <a href="mailto:{{ resume.basics.email }}">Email</a>
      <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener noreferrer">Google Scholar</a>
    </div>
  </header>
  <article class="cv">
    <section class="cv-section" aria-labelledby="cv-experience">
      <h2 id="cv-experience">Experience</h2>
      {% include resume/work.liquid entries=resume.work %}
    </section>
    <section class="cv-section" aria-labelledby="cv-education">
      <h2 id="cv-education">Education</h2>
      {% include resume/education.liquid entries=resume.education %}
    </section>
    <section class="cv-section" aria-labelledby="cv-publications">
      <h2 id="cv-publications">Publications</h2>
      {% include resume/publications.liquid %}
    </section>
    {% if resume.languages.size > 0 %}
      <section class="cv-section" aria-labelledby="cv-languages">
        <h2 id="cv-languages">Languages</h2>
        <p class="cv-languages">{% for language in resume.languages %}{{ language.language }} ({{ language.fluency | downcase }}){% unless forloop.last %} · {% endunless %}{% endfor %}</p>
      </section>
    {% endif %}
  </article>
</div>
