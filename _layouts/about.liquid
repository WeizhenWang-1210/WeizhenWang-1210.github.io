---
layout: default
---
<div class="personal-home">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <h1 id="home-title">Weizhen Wang</h1>
      <p class="hero-role">Applied Scientist · Accio Work, Alibaba</p>
      <div class="hero-intro">{{ content }}</div>
      <div class="hero-links">
        <a class="button-primary" href="#research">View research <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <figure class="hero-portrait">
      <img src="{{ page.profile.image | prepend: '/assets/img/' | replace: '//', '/' | relative_url | bust_file_cache }}" alt="{{ page.profile.alt | escape }}" width="720" height="800" fetchpriority="high">
    </figure>
  </section>

  <section class="career-section" aria-labelledby="career-title">
    <div class="section-heading"><h2 id="career-title">Experience & education</h2></div>
    <div class="career-list">
      {% for item in site.data.career %}
        <div class="career-row{% if item.current %} is-current{% endif %}">
          <div class="career-org">{{ item.organization }}{% if item.current %}<span class="current-label">Now</span>{% endif %}</div>
          <div class="career-detail"><h3>{{ item.role }}</h3>{% if item.description %}<p>{{ item.description }}</p>{% endif %}</div>
          <div class="career-period">{{ item.period }}</div>
        </div>
      {% endfor %}
    </div>
  </section>

  {% if page.selected_papers %}
    <section class="research-section" id="research" aria-labelledby="research-title">
      <div class="section-heading section-heading-link">
        <div><h2 id="research-title">Selected research</h2></div>
        <a class="text-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  {% if page.announcements.enabled %}
    <section class="updates-section" aria-labelledby="updates-title">
      <div class="section-heading"><h2 id="updates-title">News</h2></div>
      <div class="updates-list">
        <div class="update-row"><span class="update-date">Jun 2026</span><p>I joined Alibaba as an Applied Scientist on the Accio Work team.</p></div>
        <div class="update-row"><span class="update-date">May 2026</span><p>I wrapped up my time as a Staff Research Associate with Prof. Bolei Zhou at UCLA.</p></div>
        {% assign recent_news = site.news | sort: 'date' | reverse %}
        {% for item in recent_news limit: page.announcements.limit %}
          <div class="update-row"><time class="update-date" datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time><div class="update-content">{{ item.content }}</div></div>
        {% endfor %}
      </div>
      <a class="text-link archive-link" href="{{ '/news/' | relative_url }}">Earlier updates <span aria-hidden="true">↗</span></a>
    </section>
  {% endif %}

  <section class="contact-section" aria-labelledby="contact-title">
    <h2 id="contact-title">Connect</h2>
    <div class="contact-links">
      <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a href="https://github.com/{{ site.data.socials.github_username | strip }}" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  {% include visitor_map.liquid %}
</div>
