<header class="site-header">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="Main navigation">
    <div class="container">
      <a class="navbar-brand personal-brand" href="{{ '/' | relative_url }}" aria-label="Weizhen Wang home"><span class="brand-monogram" aria-hidden="true">WW</span><span>Weizhen Wang</span></a>
      <button class="navbar-toggler collapsed ml-auto" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="icon-bar top-bar"></span><span class="icon-bar middle-bar"></span><span class="icon-bar bottom-bar"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto align-items-sm-center">
          <li class="nav-item {% if page.url == '/' %}active{% endif %}"><a class="nav-link" href="{{ '/' | relative_url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>About</a></li>
          <li class="nav-item {% if page.url contains '/publications/' %}active{% endif %}"><a class="nav-link" href="{{ '/publications/' | relative_url }}" {% if page.url contains '/publications/' %}aria-current="page"{% endif %}>Research</a></li>
          <li class="nav-item {% if page.url contains '/cv/' %}active{% endif %}"><a class="nav-link" href="{{ '/cv/' | relative_url }}" {% if page.url contains '/cv/' %}aria-current="page"{% endif %}>CV</a></li>
          {% if site.search_enabled %}<li class="nav-item nav-tool"><button id="search-toggle" type="button" title="Search" aria-label="Search site" onclick="openSearchModal()"><i class="ti ti-search" aria-hidden="true"></i></button></li>{% endif %}
          {% if site.enable_darkmode %}<li class="toggle-container nav-tool"><button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme"><i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i><i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i><i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i></button></li>{% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
