{% if site.enable_clustrmaps and site.clustrmaps_id %}
  <section class="visitor-section" id="visitors" aria-labelledby="visitors-title">
    <div class="section-heading section-heading-link">
      <h2 id="visitors-title">Visitors</h2>
      <a class="text-link" href="https://clustrmaps.com/" target="_blank" rel="noopener noreferrer">ClustrMaps <span aria-hidden="true">↗</span></a>
    </div>
    <div class="visitor-map" data-visitor-map data-tracking-enabled="{% if jekyll.environment == 'production' %}true{% else %}false{% endif %}" data-script-src="https://clustrmaps.com/map_v2.js?d={{ site.clustrmaps_id | uri_escape }}&amp;cl=ffffff&amp;w=a">
      <p class="visitor-map-status" data-map-status role="status">{% if jekyll.environment == 'production' %}Loading visitor map…{% else %}Visitor tracking is disabled in this local preview.{% endif %}</p>
      <div data-map-slot></div>
      <noscript><p>JavaScript is required to display the visitor map.</p></noscript>
    </div>
    <script defer src="{{ '/assets/js/visitor-map.js' | relative_url | bust_file_cache }}"></script>
  </section>
{% endif %}
