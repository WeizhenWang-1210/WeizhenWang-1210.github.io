<ul class="cv-entry-list">
  {% assign work = include.entries | sort: 'startDate' | reverse %}
  {% for item in work %}
    <li class="cv-entry">
      <div class="cv-entry-date">{{ item.startDate | slice: 0, 7 | append: '-01' | date: '%b %Y' }} — {% if item.endDate %}{{ item.endDate | slice: 0, 7 | append: '-01' | date: '%b %Y' }}{% else %}Present{% endif %}</div>
      <div class="cv-entry-body">
        <h3>{{ item.position }}</h3>
        <p class="cv-entry-meta">{{ item.name }}</p>
        {% if item.highlights.size > 0 %}
          <ul class="cv-highlights">{% for highlight in item.highlights %}<li>{{ highlight }}</li>{% endfor %}</ul>
        {% elsif item.summary %}
          <p class="cv-entry-summary">{{ item.summary }}</p>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
