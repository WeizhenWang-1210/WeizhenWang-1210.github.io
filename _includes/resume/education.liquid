<ul class="cv-entry-list">
  {% assign education = include.entries | sort: 'startDate' | reverse %}
  {% for item in education %}
    <li class="cv-entry">
      <div class="cv-entry-date">{{ item.startDate | split: '-' | first }} — {{ item.endDate | split: '-' | first }}</div>
      <div class="cv-entry-body">
        <h3>{{ item.studyType }} {{ item.area }}</h3>
        <p class="cv-entry-meta">UCLA{% if item.studyType == 'B.S.' %} · Cum laude{% endif %}{% if item.minor %} · {{ item.minor }} minor{% endif %}</p>
      </div>
    </li>
  {% endfor %}
</ul>
